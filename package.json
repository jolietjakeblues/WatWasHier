{
  "name": "watwashier",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "build:cloudflare": "vite build",
    "preview:cloudflare": "npm run build:cloudflare && wrangler pages dev .svelte-kit/cloudflare",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy .svelte-kit/cloudflare --project-name watwashier",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:all": "npm run check && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.46.4",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "svelte": "^5.43.6",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@allmaps/maplibre": "1.0.0-beta.42",
    "maplibre-gl": "^5.8.0"
  }
}
